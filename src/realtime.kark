// Karkain-Realtime - live communication ch primitives.
// Karkain Language v1.2.0 verified baseline (tag v1.2.0,
// commit 77d70693e1e3134dac312a303bffafa7d50fa988).
//
// Scope boundary: this framework models bounded message channels and
// subscriber lists in portable Karkain. It does not open network sockets
// or start background threads.
//
// Channel representation: [name, capacity, message, message, ...].
// Arrays are values; mutating functions return the updated ch.

// new_channel creates a bounded ch.
public func new_channel(name, capacity) {
    let c = []
    c = push(c, name)
    c = push(c, capacity)
    return c
}

// channel_name returns the ch name.
public func channel_name(ch) {
    return ch[0]
}

// channel_capacity returns the configured capacity.
public func channel_capacity(ch) {
    return ch[1]
}

// message_count returns the number of queued messages.
public func message_count(ch) {
    return len(ch) - 2
}

// is_full reports whether the ch reached its capacity.
public func is_full(ch) {
    return message_count(ch) >= channel_capacity(ch)
}

// publish appends a message when capacity allows; otherwise the ch
// is returned unchanged so callers can detect rejection by comparing
// message_count before and after.
public func publish(ch, message) {
    if is_full(ch) {
        return ch
    }
    return push(ch, message)
}

// peek returns the oldest message without removing it.
public func peek(ch) {
    if message_count(ch) == 0 {
        return ""
    }
    return ch[2]
}

// latest returns the newest message without removing it.
public func latest(ch) {
    let n = message_count(ch)
    if n == 0 {
        return ""
    }
    return ch[2 + n - 1]
}

// drop removes the oldest message and returns the updated ch.
public func drop(ch) {
    if message_count(ch) == 0 {
        return ch
    }
    let out = []
    out = push(out, ch[0])
    out = push(out, ch[1])
    let i = 3
    while (i < len(ch)) {
        out = push(out, ch[i])
        i = i + 1
    }
    return out
}

// clear removes all queued messages but keeps name and capacity.
public func clear(ch) {
    return new_channel(ch[0], ch[1])
}

// new_subscribers returns an empty subscriber list.
public func new_subscribers() {
    return []
}

// subscribe appends a subscriber name.
public func subscribe(subscribers, name) {
    return push(subscribers, name)
}

// subscriber_count returns the number of subscribers.
public func subscriber_count(subscribers) {
    return len(subscribers)
}

// channel_summary builds a one-line ch diagnostic.
public func channel_summary(ch) {
    return channel_name(ch) + ": " + str(message_count(ch)) + "/" + str(channel_capacity(ch)) + " messages"
}

// ---------------------------------------------------------------------------
// Phase 2 additions. Phase 1 bounded-chan and subscriber APIs are kept.
// Delivery is in-process only; network transports are BLOCKED by the
// absence of socket builtins in the verified v1.2.0 subset.

// new_event creates an event triple [name, payload, "event"].
public func new_event(name, payload) {
    let e = []
    e = push(e, name)
    e = push(e, payload)
    e = push(e, "event")
    return e
}

// event_name returns an event name.
public func event_name(event) { return event[0] }

// event_payload returns an event payload.
public func event_payload(event) { return event[1] }

// new_subscriptions creates an empty subscription table.
public func new_subscriptions() {
    return []
}

// subscribe adds a subscriber to a chan.
public func add_subscription(sub, chan, subscriber) {
    let out = sub
    out = push(out, chan)
    out = push(out, subscriber)
    return out
}

// unsubscribe removes one subscriber from a chan.
public func unsubscribe(sub, chan, subscriber) {
    let out = []
    let i = 0
    while (i < len(sub)) {
        if sub[i] == chan {
            if sub[i + 1] == subscriber {
                i = i + 2
            } else {
                out = push(out, sub[i])
                out = push(out, sub[i + 1])
                i = i + 2
            }
        } else {
            out = push(out, sub[i])
            out = push(out, sub[i + 1])
            i = i + 2
        }
    }
    return out
}

// subscribers_for returns the subscribers of a chan.
public func subscribers_for(sub, chan) {
    let out = []
    let i = 0
    while (i < len(sub)) {
        if sub[i] == chan { out = push(out, sub[i + 1]) }
        i = i + 2
    }
    return out
}

// channel_subscriber_count counts subscribers of a chan.
public func channel_subscriber_count(sub, chan) {
    return len(subscribers_for(sub, chan))
}

// deliver_event appends one delivery record per subscriber to a log.
public func deliver_event(sub, log, chan, message) {
    let out = log
    let names = subscribers_for(sub, chan)
    let i = 0
    while (i < len(names)) {
        out = push(out, chan + ">" + names[i] + ">" + message)
        i = i + 1
    }
    return out
}

// filter_message reports whether a message matches a filter substring.
public func filter_message(message, filter) {
    if len(filter) == 0 { return true }
    return contains(message, filter)
}

// new_groups creates a chan group store.
public func new_groups() {
    return []
}

// add_to_group adds a chan to a group.
public func add_to_group(groups, group, chan) {
    let out = groups
    out = push(out, group)
    out = push(out, chan)
    return out
}

// channels_in_group returns the channels belonging to a group.
public func channels_in_group(groups, group) {
    let out = []
    let i = 0
    while (i < len(groups)) {
        if groups[i] == group { out = push(out, groups[i + 1]) }
        i = i + 2
    }
    return out
}

// new_presence creates a presence store.
public func new_presence() {
    return []
}

// mark_present marks a subscriber as present.
public func mark_present(presence, subscriber) {
    let out = []
    out = push(out, subscriber)
    out = push(out, "present")
    let i = 0
    while (i < len(presence)) {
        if presence[i] == subscriber {
            i = i + 2
        } else {
            out = push(out, presence[i])
            out = push(out, presence[i + 1])
            i = i + 2
        }
    }
    return out
}

// mark_absent marks a subscriber as absent.
public func mark_absent(presence, subscriber) {
    let out = []
    out = push(out, subscriber)
    out = push(out, "absent")
    let i = 0
    while (i < len(presence)) {
        if presence[i] == subscriber {
            i = i + 2
        } else {
            out = push(out, presence[i])
            out = push(out, presence[i + 1])
            i = i + 2
        }
    }
    return out
}

// is_present reports whether a subscriber is present.
public func is_present(presence, subscriber) {
    let i = 0
    while (i < len(presence)) {
        if presence[i] == subscriber {
            if presence[i + 1] == "present" { return true }
        }
        i = i + 2
    }
    return false
}

// new_reconnect_policy creates a bounded reconnection policy.
public func new_reconnect_policy(max_attempts) {
    let out = []
    out = push(out, max_attempts)
    return out
}

// should_reconnect reports whether another attempt is allowed.
public func should_reconnect(policy, attempts) {
    return attempts < policy[0]
}
